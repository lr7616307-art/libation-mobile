<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Libation.Mobile.UI.Converters" x:Class="Libation.Mobile.UI.Views.MainView">
  <UserControl.Resources>
    <local:CoverImageConverter x:Key="CoverImageConverter" />
    <local:CoverImageVisibilityConverter x:Key="CoverImageVisibilityConverter" />
  </UserControl.Resources>
  <Grid RowDefinitions="*,Auto,Auto" Background="#0B0911">
    <Grid Grid.Row="0">
      <ScrollViewer>
        <StackPanel Margin="20,16,20,20" Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="0" IsVisible="{Binding IsHomeNavigationSelected}">
              <TextBlock Text="VØRATH" FontSize="13" FontWeight="Bold" LetterSpacing="3" Foreground="#B9A5E8"/>
              <TextBlock Text="BEYOND THE SILENCE" FontSize="9" LetterSpacing="2" Foreground="#817494"/>
            </StackPanel>
            <Button Grid.Column="1" Content="⌕" FontSize="28" Foreground="#B9A5E8"
                    Background="Transparent" BorderThickness="0" Padding="4" Width="48" Height="44"
                    ToolTip.Tip="Search audiobooks" IsVisible="{Binding IsHomeTab}"
                    Click="OpenHomeSearchClicked"/>
          </Grid>

          <StackPanel IsVisible="{Binding IsHomeTab}" Spacing="16">
            <Border CornerRadius="8" BorderBrush="#51416F" BorderThickness="1"
                    Background="Transparent" Padding="0">
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="0">
                <Button Grid.Column="0" MinWidth="0" MinHeight="40" Padding="5,4"
                        Background="Transparent" BorderThickness="0" Click="ShowAllClicked">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
                    <TextBlock Grid.Column="0" Text="All" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding AllCount}" FontSize="9" LineHeight="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                  </Grid>
                </Button>
                <Button Grid.Column="1" MinWidth="0" MinHeight="40" Padding="5,4"
                        Background="Transparent" BorderThickness="0" Click="ShowNotStartedClicked">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
                    <TextBlock Grid.Column="0" Text="Not started" FontSize="8" LineHeight="9" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding NotStartedCount}" FontSize="9" LineHeight="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                  </Grid>
                </Button>
                <Button Grid.Column="2" MinWidth="0" MinHeight="40" Padding="5,4"
                        Background="Transparent" BorderThickness="0" Click="ShowInProgressClicked">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
                    <TextBlock Grid.Column="0" Text="In progress" FontSize="8" LineHeight="9" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding InProgressCount}" FontSize="9" LineHeight="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                  </Grid>
                </Button>
                <Button Grid.Column="3" MinWidth="0" MinHeight="40" Padding="5,4"
                        Background="Transparent" BorderThickness="0" Click="ShowFinishedClicked">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
                    <TextBlock Grid.Column="0" Text="Finished" FontSize="8" LineHeight="9" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding FinishedCount}" FontSize="9" LineHeight="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                  </Grid>
                </Button>
                <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#51416F" IsHitTestVisible="False"/>
                <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="#51416F" IsHitTestVisible="False"/>
                <Border Grid.Column="2" Width="1" HorizontalAlignment="Right" Background="#51416F" IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <TextBlock Text="{Binding AudioImportStatus}" TextWrapping="Wrap" FontSize="12" />
                        <Border CornerRadius="12" Padding="10" Background="#211A2D" IsVisible="{Binding IsSelectionMode}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding SelectedAudiobookCountLabel}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Mark status" Click="OpenStatusPickerClicked" IsEnabled="{Binding HasSelectedAudiobooks}"/>
                <Button Grid.Column="2" Content="Delete selected" Click="RemoveSelectedClicked" IsEnabled="{Binding HasSelectedAudiobooks}"/>
              </Grid>
            </Border>
            <Button Content="Select all" HorizontalAlignment="Right" IsVisible="{Binding IsSelectionMode}" Click="SelectAllClicked"/>
            <Button Content="Cancel selection" HorizontalAlignment="Right" IsVisible="{Binding IsSelectionMode}" Click="ExitSelectionClicked"/>

            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="Tomato" TextWrapping="Wrap" />

            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Continue listening" FontSize="21" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="LOCAL" FontSize="10" LetterSpacing="2" Foreground="#B9A5E8" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="Your recently played audiobooks appear here." FontSize="13" Opacity="0.65" IsVisible="{Binding HasNoRecentlyPlayedBooks}"/>
              <ItemsControl ItemsSource="{Binding RecentlyPlayedBooks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="16" Padding="12" Margin="0,0,0,8" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
                      <Grid ColumnDefinitions="72,*,Auto">
                        <Image Grid.Column="0" Width="64" Height="80" Source="{Binding CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="12,0">
                          <Button Content="{Binding Title}" FontSize="15" FontWeight="Bold" HorizontalContentAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" Tag="{Binding Id}" Click="OpenBookDetailsClicked"/>
                          <TextBlock Text="{Binding Author}" FontSize="12" Opacity="0.7"/>
                          <TextBlock Text="{Binding Length}" FontSize="11" Opacity="0.65"/>
                          <TextBlock Text="Resume from saved position" FontSize="11" Foreground="#C4B5FD"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="▶" FontSize="18" VerticalAlignment="Center" Click="PlayAudioClicked"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Your audiobooks" FontSize="21" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding CatalogueSummaryLabel}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding LocalAudioEmptyMessage}" FontSize="13" Opacity="0.65" IsVisible="{Binding HasNoLocalAudioBooks}"/>
              <ItemsControl ItemsSource="{Binding FilteredLocalAudioBooks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="16" Padding="12" Margin="0,0,0,8" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
                      <Grid ColumnDefinitions="78,*,Auto" RowDefinitions="Auto,Auto">
                        <Button Grid.RowSpan="2" Grid.Column="0" Width="68" Height="92" Padding="0" Background="Transparent" BorderThickness="0" Tag="{Binding Id}" Click="OpenBookDetailsClicked">
                          <Image Source="{Binding CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill"/>
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="3" Margin="12,0">
                          <Button Content="{Binding Title}" FontSize="15" FontWeight="Bold" HorizontalContentAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" Tag="{Binding Id}" Click="OpenBookDetailsClicked"/>
                          <TextBlock Text="{Binding Author}" FontSize="12" Opacity="0.7"/>
                          <TextBlock Text="{Binding Length}" FontSize="11" Opacity="0.6"/>
                          <TextBlock Text="{Binding Chapters.Count, StringFormat='Chapters · {0}'}" FontSize="11" Foreground="#B9A5E8"/>
                          <Border CornerRadius="8" Padding="6,3" HorizontalAlignment="Left" Background="{Binding ListeningStatus, Converter={x:Static local:ListeningStatusBackgroundConverter.Instance}}">
                            <TextBlock Text="{Binding ListeningStatus}" FontSize="10" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" Spacing="6">
                          <Button Content="⋮" FontSize="22" Padding="8,4" Background="Transparent" BorderThickness="0" Click="BookOverflowClicked"/>
                          <Button Content="▶" FontSize="20" Click="PlayAudioClicked" IsVisible="{Binding CanDelete}"/>
                          <CheckBox Content="Select" IsVisible="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}" IsChecked="{Binding IsSelectedForBulkAction, Mode=OneWay}" Click="ToggleSelectionClicked"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsHomeSearchVisible}" Spacing="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Button Grid.Column="0" Content="‹" FontSize="28" Padding="6,0"
                      Background="Transparent" BorderThickness="0" Click="CloseHomeSearchClicked"/>
              <TextBox Grid.Column="1" PlaceholderText="Search your audiobooks"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       VerticalContentAlignment="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="SEARCH RESULTS" FontSize="11" LetterSpacing="2"
                         Foreground="#B9A5E8" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding CatalogueSummaryLabel}"
                         FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding EmptyMessage}" FontSize="13" Opacity="0.7"
                       TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Books}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Tag="{Binding Id}" Click="OpenBookDetailsClicked"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Padding="0" Margin="0,0,0,8" Background="Transparent" BorderThickness="0">
                    <Border CornerRadius="16" Padding="12" Background="#171321"
                            BorderBrush="#51416F" BorderThickness="1">
                      <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="10">
                        <Image Grid.Column="0" Width="64" Height="84"
                               Source="{Binding CoverImagePath, Converter={StaticResource CoverImageConverter}}"
                               Stretch="UniformToFill"/>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Author}" FontSize="12" Opacity="0.75"/>
                          <TextBlock Text="{Binding Narrator}" FontSize="11" Opacity="0.65"/>
                          <TextBlock Text="{Binding Length}" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="#B9A5E8"
                                   VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsBookDetailsVisible}" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="AUDIOBOOK DETAILS" FontSize="11" LetterSpacing="2" Foreground="#B9A5E8" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="‹  Back" Click="CloseBookDetailsClicked"/>
            </Grid>
            <Border CornerRadius="22" Padding="18" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
              <StackPanel Spacing="13">
                <Image Width="260" Height="260" HorizontalAlignment="Center" Source="{Binding DetailBook.CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill"/>
                <TextBlock Text="{Binding DetailBook.Title}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{Binding DetailBook.Author}" FontSize="17" TextAlignment="Center" Foreground="#C4B5FD"/>
                <TextBlock Text="{Binding DetailBook.Narrator}" FontSize="14" TextAlignment="Center" Opacity="0.75"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                  <Border Grid.Column="0" Background="#211A2D" CornerRadius="10" Padding="8">
                    <StackPanel Spacing="3">
                      <TextBlock Text="DURATION" FontSize="9" LetterSpacing="1" Opacity="0.6"/>
                      <TextBlock Text="{Binding DetailDurationLabel}" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#211A2D" CornerRadius="10" Padding="8">
                    <StackPanel Spacing="3">
                      <TextBlock Text="CHAPTERS" FontSize="9" LetterSpacing="1" Opacity="0.6"/>
                      <TextBlock Text="{Binding DetailChapterLabel}" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="#211A2D" CornerRadius="10" Padding="8">
                    <StackPanel Spacing="3">
                      <TextBlock Text="FILE SIZE" FontSize="9" LetterSpacing="1" Opacity="0.6"/>
                      <TextBlock Text="{Binding DetailFileSizeLabel}" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <Border CornerRadius="8" Padding="8,5" HorizontalAlignment="Center"
                        Background="{Binding DetailBook.ListeningStatus, Converter={x:Static local:ListeningStatusBackgroundConverter.Instance}}"
                        IsVisible="{Binding IsDetailLocalBook}">
                  <TextBlock Text="{Binding DetailBook.ListeningStatus}" FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsDetailLocalBook}">
                  <Button Grid.Column="0" Content="▶  Play audiobook" FontSize="16" Click="PlayDetailBookClicked"/>
                  <Button Grid.Column="1" Content="⋮" FontSize="22" Click="DetailBookMenuClicked"/>
                </Grid>
                <Border CornerRadius="12" Padding="12" Background="#211A2D"
                        IsVisible="{Binding IsDetailProviderBook}">
                  <StackPanel Spacing="7">
                    <TextBlock Text="{Binding DetailAudibleAvailabilityLabel}" FontSize="15"
                               FontWeight="SemiBold" Foreground="#C4B5FD"/>
                    <Button Content="{Binding DetailBook.DownloadActionLabel}" HorizontalAlignment="Stretch"
                            FontSize="17" Padding="14,12"
                            Click="DownloadAudibleBookFromDetailClicked"/>
                    <TextBlock Text="{Binding DownloadSettingsStatus}"
                               FontSize="11" Opacity="0.78" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AudioImportStatus}" FontSize="12"
                               Foreground="#F0C6A8" TextWrapping="Wrap"/>
                    <Button Content="▶  Play audiobook in VØRATH" HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasPlayableDetailAudio}" Click="PlayDetailBookClicked"/>
                    <TextBlock Text="{Binding DetailProtectedDownloadLabel}"
                               IsVisible="{Binding HasProtectedDetailDownload}"
                               FontSize="12" Opacity="0.78" TextWrapping="Wrap"/>
                    <Button Content="Cancel Audible operation"
                            IsVisible="{Binding IsProtectedAudibleOperationInProgress}"
                            HorizontalAlignment="Stretch"
                            Click="CancelProtectedAudibleOperationClicked"/>
                    <TextBlock Text="Diagnostic only: sends a renewal challenge to Audible and reports response metadata. It does not install the returned licence or replace this offline copy."
                               IsVisible="{Binding DetailBook.IsWidevineOfflineAvailable}"
                               FontSize="10" Opacity="0.68" TextWrapping="Wrap"/>
                    <Button Content="Check Audible renewal support"
                            IsVisible="{Binding DetailBook.IsWidevineOfflineAvailable}"
                            HorizontalAlignment="Stretch"
                            Click="ProbeAudibleRenewalClicked"/>
                    <Button Content="Remove offline copy"
                            IsVisible="{Binding DetailBook.IsWidevineOfflineAvailable}"
                            HorizontalAlignment="Stretch"
                            Click="RemoveAudibleOfflineBookClicked"/>
                  </StackPanel>
                </Border>
                <Border CornerRadius="12" Padding="12" Background="#211A2D"
                        IsVisible="{Binding IsDetailLocalBook}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="DOWNLOAD AUTHORIZED AUDIO" FontSize="11" LetterSpacing="1.5"
                               Foreground="#B9A5E8" FontWeight="SemiBold"/>
                    <TextBox x:Name="AuthorizedDownloadUrlBox"
                             PlaceholderText="Paste direct HTTPS audio URL (.mp3, .m4b, etc.)"/>
                    <TextBlock Text="Use a direct public HTTPS audio link you are authorized to download. Links with login credentials, query tokens or fragments are not accepted. For Audible titles, use the Download button in the Audible Library."
                               FontSize="11" Opacity="0.72" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DownloadSettingsStatus}" FontSize="11"
                               Foreground="#B9A5E8" TextWrapping="Wrap"/>
                    <Button Content="⇩  Download to selected folder"
                            HorizontalAlignment="Stretch" Click="QueueAuthorizedDownloadClicked"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border CornerRadius="18" Padding="16" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="ABOUT THIS AUDIOBOOK" FontSize="11" LetterSpacing="2" Foreground="#B9A5E8"/>
                <TextBlock Text="{Binding DetailBookDescription}" TextWrapping="Wrap" LineHeight="22"/>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding CanEditDetailBook}">
              <Button Grid.Column="0" Content="Edit information" Click="EditDetailBookClicked"/>
              <Button Grid.Column="1" Content="Change cover" Click="ChooseCoverFromDetailClicked"/>
            </Grid>
            <StackPanel Spacing="8">
              <TextBlock Text="CHAPTERS" FontSize="11" LetterSpacing="2" Foreground="#B9A5E8"/>
              <TextBlock Text="{Binding DetailChapterEmptyMessage}" FontSize="12" Opacity="0.65" IsVisible="{Binding HasNoDetailBookChapters}"/>
              <ItemsControl ItemsSource="{Binding DetailBook.Chapters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" FontSize="13"/>
                      <TextBlock Grid.Column="1" Text="{Binding StartTimeLabel}" FontSize="12" Opacity="0.65" Margin="8,0,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsEditVisible}" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Edit audiobook" FontSize="26" FontWeight="Bold"/>
              <Button Grid.Column="1" Content="Cancel" Click="CancelDetailEditClicked"/>
            </Grid>
            <TextBox PlaceholderText="Title" Text="{Binding NewTitle}"/>
            <TextBox PlaceholderText="Author" Text="{Binding NewAuthor}"/>
            <TextBox PlaceholderText="Narrator" Text="{Binding NewNarrator}"/>
            <TextBox PlaceholderText="Duration" Text="{Binding NewLength}"/>
            <TextBox PlaceholderText="Series" Text="{Binding NewSeries}"/>
            <TextBox PlaceholderText="Genre" Text="{Binding NewGenre}"/>
            <TextBox PlaceholderText="Description / summary" Text="{Binding NewDescription}" AcceptsReturn="True" MinHeight="150"/>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="Tomato" TextWrapping="Wrap"/>
            <Button Content="Save changes" Click="SaveDetailEditClicked"/>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsAudibleLibraryTab}" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Audible Library" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Books in your Audible account" FontSize="13" Opacity="0.7"/>
              </StackPanel>
              <Button Grid.Column="1" Content="⟳  Sync" Click="SyncLibraryClicked" IsEnabled="{Binding CanSync}" VerticalAlignment="Center"/>
            </Grid>
            <TextBox PlaceholderText="Search Audible titles or authors" Text="{Binding AudibleSearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding SyncStatus}" FontSize="12" TextWrapping="Wrap" Opacity="0.8"/>
            <TextBlock Text="{Binding AudioImportStatus}" FontSize="12"
                       Foreground="#F0C6A8" TextWrapping="Wrap"/>
            <Button Content="Cancel current Audible operation"
                    IsVisible="{Binding IsProtectedAudibleOperationInProgress}"
                    HorizontalAlignment="Stretch"
                    Click="CancelProtectedAudibleOperationClicked"/>
            <TextBlock Text="{Binding LastSuccessfulSyncLabel}" FontSize="11" Opacity="0.6"/>
            <TextBlock Text="{Binding AudibleLibraryEmptyMessage}" FontSize="14" Opacity="0.7" IsVisible="{Binding HasNoAudibleBooks}"/>
            <ItemsControl ItemsSource="{Binding AudibleBooks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="16" Padding="12" Margin="0,0,0,8" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
                    <Grid ColumnDefinitions="78,*,Auto">
                      <Button Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                              Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Click="AudibleBookClicked">
                        <Grid ColumnDefinitions="78,*">
                          <Border Grid.Column="0" Width="68" Height="92" CornerRadius="8" ClipToBounds="True" Background="#292238">
                            <Grid>
                              <Image Source="{Binding CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill"/>
                              <TextBlock Text="◉" FontSize="28" Foreground="#B9A5E8"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsVisible="{Binding HasNoCoverArt}"/>
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Author}" FontSize="12" Opacity="0.78"/>
                            <TextBlock Text="{Binding Narrator}" FontSize="11" Opacity="0.68"/>
                            <TextBlock Text="{Binding Length}" FontSize="11" Opacity="0.6"/>
                          </StackPanel>
                        </Grid>
                      </Button>
                      <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="{Binding DownloadActionLabel}" FontSize="10" Padding="7,8"
                                Click="DownloadAudibleBookClicked"/>
                        <TextBlock Text="{Binding AudibleAvailabilityShortLabel}" FontSize="8" LetterSpacing="0.3"
                                   Foreground="#B9A5E8" TextAlignment="Center" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel x:Name="AccountContentPanel" IsVisible="{Binding IsAudibleAccountTab}" Spacing="16">
            <TextBlock Text="Accounts" FontSize="30" FontWeight="Bold"/>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsSettingsHomeVisible}" Spacing="16">
            <TextBlock Text="Settings" FontSize="30" FontWeight="Bold"/>
            <Border CornerRadius="16" Padding="14" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
              <Button Background="Transparent" BorderThickness="0" Padding="4"
                      HorizontalContentAlignment="Stretch" Click="OpenDownloadsPageClicked">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Downloads" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Progress, active downloads, pause, resume and download settings"
                               FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="›" FontSize="30" Foreground="#B9A5E8"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </Border>
            <Border CornerRadius="16" Padding="16" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Backup and restore" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="Back up your catalogue metadata or restore it later. Audio files and account credentials are not included." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Content="Export backup" Click="ExportBackupClicked"/>
                  <Button Grid.Column="1" Content="Import backup" Click="ImportBackupClicked"/>
                </Grid>
                <TextBlock Text="{Binding BackupMessage}" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock Text="{Binding PendingImportLabel}" IsVisible="{Binding HasPendingImport}" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPendingImport}">
                  <Button Grid.Column="0" Content="Confirm restore" Click="ConfirmImportClicked"/>
                  <Button Grid.Column="1" Content="Cancel" Margin="8,0,0,0" Click="CancelImportClicked"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border CornerRadius="16" Padding="16" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="App information" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="VØRATH · Beyond the Silence" FontSize="13" Opacity="0.7"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsDownloadsPageVisible}" Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Button Grid.Column="0" Content="‹  Back" Padding="12,8" Click="CloseDownloadsPageClicked"/>
              <TextBlock Grid.Column="1" Text="Downloads" FontSize="28" FontWeight="Bold"
                         VerticalAlignment="Center"/>
            </Grid>
            <Border CornerRadius="16" Padding="16" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
              <StackPanel Spacing="11">
                <TextBlock Text="Download settings" FontSize="19" FontWeight="Bold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Download directory" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DownloadDirectoryLabel}" FontSize="12" Opacity="0.78" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Choose folder" Padding="12,9"
                          VerticalAlignment="Center" Click="ChooseDownloadFolderClicked"/>
                </Grid>
                <TextBlock Text="Android will remember the folder permission. You can change it at any time."
                           FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                <Border Height="1" Background="#40324F" Margin="0,2"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="File organization" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DownloadFolderOrganizationLabel}" FontSize="12" Foreground="#C4B5FD"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Change" Padding="16,9"
                          VerticalAlignment="Center" Click="CycleDownloadFolderOrganizationClicked"/>
                </Grid>
                <TextBlock Text="{Binding DownloadFolderOrganizationExample}" FontSize="11" Opacity="0.68" TextWrapping="Wrap"/>
                <Border Height="1" Background="#40324F" Margin="0,2"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Audible download quality" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AudibleDownloadQualityLabel}" FontSize="12" Foreground="#C4B5FD"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Change" Padding="16,9"
                          VerticalAlignment="Center" Click="CycleAudibleDownloadQualityClicked"/>
                </Grid>
                <TextBlock Text="{Binding DownloadSettingsStatus}" FontSize="11" Foreground="#B9A5E8" TextWrapping="Wrap"/>
                <TextBlock Text="Audible downloads remain encrypted and protected. Unprotected audio is saved to the selected folder."
                           FontSize="11" Opacity="0.68" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border CornerRadius="16" Padding="16" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Download queue" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="{Binding QueueSummaryLabel}" FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                <Button Content="{Binding DownloadQueueActionLabel}" HorizontalAlignment="Stretch"
                        Padding="14,11" Click="DownloadQueueActionClicked"/>
                <StackPanel Spacing="5" IsVisible="{Binding HasActiveDownloadProgress}">
                  <TextBlock Text="{Binding ActiveDownloadProgressTitle}" FontSize="13" FontWeight="SemiBold"/>
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding ActiveDownloadProgressPercent}" Height="7"/>
                  <TextBlock Text="{Binding ActiveDownloadProgressLabel}" FontSize="11" Opacity="0.72"/>
                </StackPanel>
                <TextBlock Text="No downloads yet. Start a download from an audiobook’s details page."
                           FontSize="12" Opacity="0.65" IsVisible="{Binding IsQueueEmpty}"/>
                <ItemsControl ItemsSource="{Binding QueueItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="12" Padding="12" Margin="0,4"
                              Background="#211A2D" BorderBrush="#51416F" BorderThickness="1">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" FontSize="14"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11"
                                       Foreground="#C4B5FD" VerticalAlignment="Top"/>
                          </Grid>
                          <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#E89A9A"
                                     TextWrapping="Wrap" IsVisible="{Binding HasErrorMessage}"/>
                          <StackPanel Spacing="4" IsVisible="{Binding HasProgress}">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Height="6"/>
                            <TextBlock Text="{Binding ProgressLabel}" FontSize="11" Opacity="0.72"/>
                          </StackPanel>
                          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Content="{Binding DownloadActionLabel}" Padding="8,8"
                                    IsVisible="{Binding CanToggleAudibleDownload}"
                                    Click="QueueAudibleDownloadActionClicked"/>
                            <Button Grid.Column="1" Content="Retry" Padding="8,8"
                                    IsVisible="{Binding CanRetry}" Click="RetryQueueClicked"/>
                            <Button Grid.Column="2" Content="Remove" Padding="8,8"
                                    IsVisible="{Binding CanRemove}" Click="RemoveQueueClicked"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsFullPlayerVisible}" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <Button Grid.Column="0" Content="‹  Back" HorizontalAlignment="Left" Click="CloseFullPlayerClicked"/>
              <Button Grid.Column="1" Content="☷  Chapters" Click="OpenChaptersClicked"/>
            </Grid>
            <Border CornerRadius="24" Padding="18" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
              <StackPanel Spacing="14">
                <Image Width="320" Height="320" HorizontalAlignment="Center" Source="{Binding NowPlayingBook.CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill"/>
                <TextBlock Text="{Binding NowPlayingBook.Title}" FontSize="24" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NowPlayingBook.Author}" FontSize="16" TextAlignment="Center" Opacity="0.7"/>
                <TextBlock x:Name="CurrentChapterTitleLabel" Text="Ready when you are" FontSize="14" TextAlignment="Center" Foreground="#D8C7FF" TextWrapping="Wrap"/>
                <TextBlock x:Name="ChapterProgressLabel" Text="{Binding NowPlayingChapterCountLabel}" FontSize="12" TextAlignment="Center" Opacity="0.65"/>
                <Slider x:Name="PlaybackSeekSlider" Minimum="0" Maximum="1000" Value="0" IsEnabled="False"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                  <TextBlock x:Name="PlaybackPositionLabel" Grid.Column="0" Text="00:00" FontSize="11" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="PlaybackDurationLabel" Grid.Column="1" Text="--:--" FontSize="11" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="PlaybackRemainingLabel" Grid.Column="2" Text="−--:--" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="3">
                  <Button Grid.Column="0" Content="⏮" FontSize="22" Click="PreviousChapterClicked"/>
                  <Button Grid.Column="1" Content="↶" FontSize="22" ToolTip.Tip="Rewind 10 seconds" Click="RewindAudioClicked"/>
                  <Button x:Name="PlayPauseButton" Grid.Column="2" Content="▶" FontSize="25" Click="TogglePlaybackClicked"/>
                  <Button Grid.Column="3" Content="↷" FontSize="22" ToolTip.Tip="Forward 10 seconds" Click="ForwardAudioClicked"/>
                  <Button Grid.Column="4" Content="⏭" FontSize="22" Click="NextChapterClicked"/>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Button x:Name="PlaybackSpeedButton" Grid.Column="0" Content="Speed · 1.0×" Click="PlaybackSpeedClicked"/>
                  <Button x:Name="SleepTimerButton" Grid.Column="1" Content="Timer" Click="SleepTimerClicked"/>
                  <Button Grid.Column="2" Content="Chapters" Click="OpenChaptersClicked"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsChaptersVisible}" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Chapters" FontSize="26" FontWeight="Bold"/>
              <Button Grid.Column="1" Content="Done" Click="CloseChaptersClicked"/>
            </Grid>
            <TextBlock Text="{Binding NowPlayingBook.Title}" FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding NowPlayingBook.Chapters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button HorizontalContentAlignment="Stretch" Padding="14" Margin="0,0,0,6" Click="ChapterSelectedClicked" Tag="{Binding StartPositionMilliseconds}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding StartTimeLabel}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Button IsVisible="{Binding IsHomeTab}"
              Width="56" Height="56" MinWidth="56" MinHeight="56"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,18,12" Padding="0"
              Background="#8B5CF6" BorderThickness="0" CornerRadius="28"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              ZIndex="10" ToolTip.Tip="Import audiobook"
              Click="ImportAudiobookClicked">
        <TextBlock Text="＋" FontSize="30" FontWeight="Light"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center"/>
      </Button>
    </Grid>

    <Border Grid.Row="1" Background="#181421" BorderBrush="#51416F" BorderThickness="1,1,1,0"
            Padding="10,8" IsVisible="{Binding HasNowPlayingBook}">
      <Grid ColumnDefinitions="52,*,Auto,Auto" ColumnSpacing="9">
        <Button Grid.Column="0" Padding="0" Background="Transparent" BorderThickness="0" Click="OpenFullPlayerClicked">
          <Image Width="48" Height="48" Source="{Binding NowPlayingBook.CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill"/>
        </Button>
        <Button Grid.Column="1" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="2" Click="OpenFullPlayerClicked">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding NowPlayingBook.Title}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" MaxLines="1"/>
            <TextBlock Text="{Binding NowPlayingBook.Author}" FontSize="10" Opacity="0.65" MaxLines="1"/>
          </StackPanel>
        </Button>
        <Button x:Name="MiniRewindButton" Grid.Column="2" Content="↶" FontSize="20" ToolTip.Tip="Rewind 10 seconds" Padding="8" Click="RewindAudioClicked"/>
        <Button x:Name="MiniPlayPauseButton" Grid.Column="3" Content="▶" FontSize="20" Padding="10" Click="TogglePlaybackClicked"/>
      </Grid>
    </Border>

          <Border Grid.Row="0" Background="#0B0911" IsVisible="{Binding IsBookMenuVisible}" ZIndex="20">
            <Border Background="#211A2D" CornerRadius="22" Padding="20" VerticalAlignment="Bottom" Margin="8" BorderBrush="#69568D" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding MenuBook.Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <Button Content="▶  Play" HorizontalContentAlignment="Left" Click="PlayMenuBookClicked"/>
                <Button Content="Edit" HorizontalContentAlignment="Left" Click="EditImportedBookClicked"/>
                <Button Content="Info" HorizontalContentAlignment="Left" Click="BookInfoClicked"/>
                <Button Content="Remove" Foreground="#FF7B83" HorizontalContentAlignment="Left" Click="RemoveImportedBookClicked"/>
                <Button Content="Select multiple audiobooks" HorizontalContentAlignment="Left" Click="BeginSelectionClicked"/>
                <Button Content="Close" Click="CloseBookMenuClicked"/>
              </StackPanel>
            </Border>
          </Border>
          <Border Grid.Row="0" Background="#0B0911" IsVisible="{Binding IsInfoVisible}" ZIndex="21">
            <Border Background="#171321" CornerRadius="22" Padding="20" VerticalAlignment="Center" Margin="12" BorderBrush="#69568D" BorderThickness="1">
              <ScrollViewer>
                <StackPanel Spacing="12">
                  <TextBlock Text="Audiobook information" FontSize="22" FontWeight="Bold"/>
                  <Image Width="180" Height="220" Source="{Binding MenuBook.CoverImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding MenuBook.Title}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding MenuBookMetadataLabel}" TextWrapping="Wrap"/>
                  <TextBlock Text="DESCRIPTION" FontSize="11" LetterSpacing="2" Foreground="#B9A5E8"/>
                  <TextBlock Text="{Binding MenuBookDescription}" TextWrapping="Wrap"/>
                  <Button Content="Change cover artwork" Click="ChooseCoverFromInfoClicked"/>
                  <Button Content="Done" Click="CloseBookInfoClicked"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Border>
          <Border Grid.Row="0" Background="#0B0911" IsVisible="{Binding IsStatusPickerVisible}" ZIndex="22">
            <Border Background="#171321" CornerRadius="22" Padding="20" VerticalAlignment="Center" Margin="12" BorderBrush="#69568D" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Listening status" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedAudiobookCountLabel}" Opacity="0.7"/>
                <Button Content="Finished" Background="#1E8B50" Click="MarkFinishedClicked"/>
                <Button Content="In progress" Background="#C63E46" Click="MarkInProgressClicked"/>
                <Button Content="Not started" Background="#C17A18" Click="MarkNotStartedClicked"/>
                <Button Content="Cancel" Click="CloseStatusPickerClicked"/>
              </StackPanel>
            </Border>
          </Border>

    <Border Grid.Row="0" Background="#B8000000" IsVisible="{Binding IsQueueRemovalConfirmationVisible}" ZIndex="32">
      <Border Background="#211A2D" CornerRadius="20" Padding="20" Margin="20"
              VerticalAlignment="Center" HorizontalAlignment="Stretch"
              BorderBrush="#69568D" BorderThickness="1">
        <StackPanel Spacing="16">
          <TextBlock Text="Remove download?" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="{Binding QueueRemovalConfirmationMessage}" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" Content="Keep download" Click="CancelQueueRemovalClicked"/>
            <Button Grid.Column="1" Content="Remove from queue" Foreground="#FF7B83" Click="ConfirmQueueRemovalClicked"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.Row="0" Background="#B8000000" IsVisible="{Binding IsRemovalConfirmationVisible}" ZIndex="30">
      <Border Background="#211A2D" CornerRadius="20" Padding="20" Margin="20"
              VerticalAlignment="Center" HorizontalAlignment="Stretch"
              BorderBrush="#69568D" BorderThickness="1">
        <StackPanel Spacing="16">
          <TextBlock Text="Confirm removal" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="{Binding RemovalConfirmationMessage}" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" Content="Cancel" Click="CancelRemovalClicked"/>
            <Button Grid.Column="1" Content="Remove" Foreground="#FF7B83" Click="ConfirmRemovalClicked"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.Row="0" IsVisible="{Binding IsAddAccountSheetVisible}"
            Background="#99000000" ZIndex="31">
      <Border VerticalAlignment="Bottom" Background="#242A35" CornerRadius="26,26,0,0"
              Padding="24,28,24,30" BorderBrush="#343B49" BorderThickness="1,1,0,0">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Add Account" FontSize="24" FontWeight="Bold"/>
            <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0"
                    FontSize="22" Click="CloseAddAccountSheetClicked"/>
          </Grid>
          <TextBlock Text="Choose an audiobook source to connect." FontSize="14" Opacity="0.72"/>
          <Button MinHeight="104" Padding="16" Background="#2B313D" BorderBrush="#3B4351"
                  BorderThickness="1" CornerRadius="16" Click="AudibleAddAccountClicked">
            <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="12">
              <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14" Background="#182E37"
                      VerticalAlignment="Center">
                <TextBlock Text="◉" FontSize="34" Foreground="#78B9C6"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Audible" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Sign in to sync and download your Audible library."
                           FontSize="13" Opacity="0.75" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="›" FontSize="30" VerticalAlignment="Center" Opacity="0.8"/>
            </Grid>
          </Button>
          <Border MinHeight="104" Padding="16" Background="#2B313D" BorderBrush="#3B4351"
                  BorderThickness="1" CornerRadius="16" Opacity="0.58">
            <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="12">
              <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14" Background="#253640"
                      VerticalAlignment="Center">
                <TextBlock Text="▤" FontSize="30" Foreground="#78B9C6"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Libro.fm" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="DRM-free audiobook accounts are not connected in this build."
                           FontSize="13" Opacity="0.75" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="›" FontSize="30" VerticalAlignment="Center" Opacity="0.8"/>
            </Grid>
          </Border>
          <Border MinHeight="104" Padding="16" Background="#2B313D" BorderBrush="#3B4351"
                  BorderThickness="1" CornerRadius="16" Opacity="0.58">
            <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="12">
              <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14" Background="#253640"
                      VerticalAlignment="Center">
                <TextBlock Text="C" FontSize="32" FontWeight="Bold" Foreground="#78B9C6"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Chirp" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Chirp account connection is not available in this build."
                           FontSize="13" Opacity="0.75" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="›" FontSize="30" VerticalAlignment="Center" Opacity="0.8"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.Row="2" HorizontalAlignment="Stretch" Background="#0B0911"
            BorderBrush="#51416F" BorderThickness="0,1,0,0" Padding="4,2">
      <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,*,*,*" ColumnSpacing="0">
        <Button Grid.Column="0" Classes="quiet-nav" MinWidth="0" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,4"
                Background="Transparent" BorderThickness="0" Click="HomeTabClicked">
          <StackPanel HorizontalAlignment="Center" Spacing="3">
            <TextBlock Text="⌂" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Home" FontSize="10" HorizontalAlignment="Center"/>
            <Border Height="2" Background="#8A8790" IsVisible="{Binding IsHomeNavigationSelected}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="quiet-nav" MinWidth="0" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,4"
                Background="Transparent" BorderThickness="0" Click="AudibleLibraryTabClicked">
          <StackPanel HorizontalAlignment="Center" Spacing="3">
            <TextBlock Text="▤" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Library" FontSize="10" HorizontalAlignment="Center"/>
            <Border Height="2" Background="#8A8790" IsVisible="{Binding IsAudibleLibraryTab}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="quiet-nav" MinWidth="0" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,4"
                Background="Transparent" BorderThickness="0" Click="AudibleAccountTabClicked">
          <StackPanel HorizontalAlignment="Center" Spacing="3">
            <TextBlock Text="♙" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Account" FontSize="10" HorizontalAlignment="Center"/>
            <Border Height="2" Background="#8A8790" IsVisible="{Binding IsAudibleAccountTab}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="quiet-nav" MinWidth="0" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,4"
                Background="Transparent" BorderThickness="0" Click="SettingsTabClicked">
          <StackPanel HorizontalAlignment="Center" Spacing="3">
            <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Settings" FontSize="10" HorizontalAlignment="Center"/>
            <Border Height="2" Background="#8A8790" IsVisible="{Binding IsSettingsTab}"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>