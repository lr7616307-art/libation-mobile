<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Libation.Mobile.UI.Converters" x:Class="Libation.Mobile.UI.Views.MainView">
  <UserControl.Resources>
    <local:CoverImageConverter x:Key="CoverImageConverter" />
    <local:CoverImageVisibilityConverter x:Key="CoverImageVisibilityConverter" />
  </UserControl.Resources>
  <TabControl>
    <TabItem Header="Home">
      <ScrollViewer>
        <StackPanel Margin="20" Spacing="18">
          <TextBlock Text="NOW PLAYING" FontSize="12" FontWeight="Bold" LetterSpacing="2" Foreground="#B9A5E8" />
          <Border CornerRadius="24" Padding="18" Background="#171321" BorderBrush="#51416F" BorderThickness="1">
            <StackPanel Spacing="16">
              <Grid Width="250" Height="250" HorizontalAlignment="Center">
                <Border CornerRadius="18" Background="#120F22" BorderBrush="#51416F" BorderThickness="1">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="VØ" FontSize="58" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" />
                    <TextBlock Text="VØRATH" FontSize="12" LetterSpacing="3" Foreground="#B9A5E8" />
                  </StackPanel>
                </Border>
                <Image Source="{Binding NowPlayingBook.CoverImagePath, Converter={StaticResource CoverImageConverter}}"
                       IsVisible="{Binding NowPlayingBook.CoverImagePath, Converter={StaticResource CoverImageVisibilityConverter}}"
                       Stretch="UniformToFill" />
              </Grid>
              <TextBlock Text="{Binding NowPlayingBook.Title, FallbackValue='Choose an audiobook'}" FontSize="24" FontWeight="Bold"
                         TextAlignment="Center" TextWrapping="Wrap" Foreground="#F3EFFF" />
              <TextBlock Text="{Binding NowPlayingBook.Author}" FontSize="16" Opacity="0.75" TextAlignment="Center" />
              <TextBlock x:Name="CurrentChapterTitleLabel" Text="Ready when you are" FontSize="15" Foreground="#D8C7FF"
                         TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock x:Name="ChapterProgressLabel" Text="{Binding NowPlayingChapterCountLabel}" FontSize="12"
                         Opacity="0.7" TextAlignment="Center" />
              <Slider x:Name="PlaybackSeekSlider" Minimum="0" Maximum="1000" Value="0" IsEnabled="False" />
              <Button Content="Jump to position" Click="SeekToSelectedPositionClicked" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="PlaybackPositionLabel" Grid.Column="0" Text="00:00" FontSize="12" />
                <TextBlock x:Name="PlaybackDurationLabel" Grid.Column="1" Text="--:--" FontSize="12" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4" HorizontalAlignment="Center">
                <Button Grid.Column="0" Content="|◀" Click="PreviousChapterClicked" />
                <Button Grid.Column="1" Content="↶ 15" Click="RewindAudioClicked" />
                <Button x:Name="PlayPauseButton" Grid.Column="2" Content="▶" FontSize="22" Click="TogglePlaybackClicked" />
                <Button Grid.Column="3" Content="15 ↷" Click="ForwardAudioClicked" />
                <Button Grid.Column="4" Content="▶|" Click="NextChapterClicked" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="PlaybackSpeedButton" Grid.Column="0" Content="Speed · 1.0×" Click="PlaybackSpeedClicked" />
                <Button x:Name="SleepTimerButton" Grid.Column="1" Content="Sleep timer · Off" Click="SleepTimerClicked" />
              </Grid>
            </StackPanel>
          </Border>
          <Border CornerRadius="18" Padding="16" BorderBrush="#51416F" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="CHAPTERS" FontSize="12" FontWeight="Bold" LetterSpacing="2" Foreground="#B9A5E8" />
              <TextBlock Text="Chapters embedded in the audiobook will appear here." FontSize="13" Opacity="0.7"
                         IsVisible="{Binding HasNoNowPlayingChapters}" />
              <ItemsControl ItemsSource="{Binding NowPlayingBook.Chapters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding StartTimeLabel}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding AudioImportStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Library">
      <ScrollViewer>
        <StackPanel Margin="20" Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="VØRATH" FontSize="12" FontWeight="Bold" Opacity="0.65" />
            <TextBlock Text="Your library" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Your audiobooks. Automatically organised." FontSize="14" Opacity="0.7" />
          </StackPanel>
          <TextBox PlaceholderText="Search titles or authors" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="＋  Import Audiobook" FontSize="18" MinHeight="58" Click="ImportAudiobookClicked" />
          <TextBlock Text="{Binding AudioImportStatus}" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="Tomato" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CatalogueSummaryLabel}" FontSize="12" Opacity="0.65" />
          <ItemsControl ItemsSource="{Binding Books}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="16" Padding="14" Margin="0,0,0,10" BorderBrush="#51416F" BorderThickness="1" Background="#171321">
                  <Grid ColumnDefinitions="104,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Width="92" Height="128" Margin="0,0,12,0">
                      <Border CornerRadius="10" Background="#120F22" BorderBrush="#51416F" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                          <TextBlock Text="VØ" FontSize="28" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" />
                          <TextBlock Text="VØRATH" FontSize="8" LetterSpacing="1" Foreground="#B9A5E8" />
                        </StackPanel>
                      </Border>
                      <Image Source="{Binding CoverImagePath, Converter={StaticResource CoverImageConverter}}"
                             IsVisible="{Binding CoverImagePath, Converter={StaticResource CoverImageVisibilityConverter}}" Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Author}" Margin="0,5,0,0" Opacity="0.75" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Narrator}" Margin="0,3,0,0" FontSize="12" Opacity="0.65" />
                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Spacing="5" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Length}" FontSize="12" />
                      <TextBlock Text="{Binding Chapters.Count, StringFormat='Chapters · {0}'}" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                      <Button Grid.Column="0" Content="▶  Play" Click="PlayAudioClicked" />
                      <Button Grid.Column="1" Content="Remove" Margin="8,0,0,0" IsEnabled="{Binding CanDelete}" Click="DeleteBookClicked" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding EmptyMessage}" FontSize="13" Opacity="0.7" HorizontalAlignment="Center" />
          <Border CornerRadius="14" Padding="16" BorderBrush="#555555" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="Backup and restore" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Keep a copy of your library metadata and restore it later. Audio files and account credentials are not included."
                         TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
              <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Content="Export backup" Click="ExportBackupClicked" />
                <Button Grid.Column="1" Content="Import backup" Margin="8,0,0,0" Click="ImportBackupClicked" />
              </Grid>
              <TextBlock Text="{Binding BackupMessage}" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="{Binding PendingImportLabel}" IsVisible="{Binding HasPendingImport}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPendingImport}">
                <Button Grid.Column="0" Content="Confirm restore" Click="ConfirmImportClicked" />
                <Button Grid.Column="1" Content="Cancel" Margin="8,0,0,0" Click="CancelImportClicked" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Account">
      <ScrollViewer>
        <StackPanel Margin="20" Spacing="16">
          <TextBlock Text="Audible account" FontSize="28" FontWeight="Bold" />
          <Border CornerRadius="14" Padding="16" BorderBrush="#555555" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="Account connection" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding LastSuccessfulSyncLabel}" FontSize="12" Opacity="0.7" />
              <Button Content="Sync Audible library" IsEnabled="{Binding CanSync}" Click="SyncLibraryClicked" />
              <TextBlock Text="Sign-in and secure token management are being integrated. This page does not claim an account is connected unless the provider reports it." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Settings">
      <ScrollViewer>
        <StackPanel Margin="20" Spacing="16">
          <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />
          <Border CornerRadius="14" Padding="16" BorderBrush="#555555" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="Catalogue backup" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Export or restore catalogue metadata. Credentials, audio files and queue items are not included." TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
              <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Content="Export backup" Click="ExportBackupClicked" />
                <Button Grid.Column="1" Content="Import backup" Margin="8,0,0,0" Click="ImportBackupClicked" />
              </Grid>
              <TextBlock Text="{Binding BackupMessage}" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="{Binding PendingImportLabel}" IsVisible="{Binding HasPendingImport}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPendingImport}">
                <Button Grid.Column="0" Content="Confirm replace catalogue" Click="ConfirmImportClicked" />
                <Button Grid.Column="1" Content="Cancel" Margin="8,0,0,0" Click="CancelImportClicked" />
              </Grid>
            </StackPanel>
          </Border>
          <Border CornerRadius="14" Padding="16" BorderBrush="#555555" BorderThickness="1">
            <StackPanel Spacing="6">
              <TextBlock Text="Download and storage" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Storage location, file naming, download quality, Wi-Fi-only mode and batch download controls will be added here as their underlying services become available." TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>