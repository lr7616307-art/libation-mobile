<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Libation.Mobile.UI.Views.MainView">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="LIBATION MOBILE" FontSize="12" FontWeight="Bold" Opacity="0.65" />
        <TextBlock Text="Your library" FontSize="30" FontWeight="Bold" />
        <TextBlock Text="A mobile audiobook manager" FontSize="14" Opacity="0.7" />
      </StackPanel>
      <TextBox PlaceholderText="Search titles, authors or narrators"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
      <Border CornerRadius="14" Padding="14" Background="#3157A4">
        <StackPanel Spacing="4">
          <TextBlock Text="PROTOTYPE MODE" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Local catalogue and download queue are saved on this device. Queue entries track status only; Audible sign-in, library sync and audio downloads are not connected."
                     TextWrapping="Wrap" Foreground="White" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Local catalogue" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Reload" Click="ReloadClicked" />
      </Grid>
      <TextBlock Text="Loading catalogue…" IsVisible="{Binding IsLoading}" FontSize="13" Opacity="0.7" />
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="Tomato"
                 TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Books}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="12" Padding="14" Margin="0,0,0,10"
                    BorderBrush="#555555" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="17"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Author}"
                           Margin="0,5,0,0" Opacity="0.75" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Narrator}"
                           Margin="0,3,0,0" FontSize="12" Opacity="0.65" />
                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                            VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                  <TextBlock Text="{Binding Length}" FontSize="12" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7"
                             HorizontalAlignment="Right" />
                </StackPanel>
                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="Add to download queue" HorizontalAlignment="Stretch"
                        Margin="0,10,0,0" Click="QueueClicked" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding EmptyMessage}" FontSize="13" Opacity="0.7"
                 HorizontalAlignment="Center" />
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding QueueCountLabel}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Nothing queued yet." IsVisible="{Binding IsQueueEmpty}"
                   FontSize="13" Opacity="0.7" />
        <ItemsControl ItemsSource="{Binding QueueItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="10" Padding="12" Margin="0,0,0,8"
                      BorderBrush="#555555" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding AudiobookId}" VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                  <Button Grid.Column="2" Content="Remove" Margin="8,0,0,0"
                          Click="RemoveQueueClicked" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <TextBlock Text="Demo catalogue saved locally · Queue does not download files"
                 FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                 HorizontalAlignment="Center" Margin="0,8,0,16" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
