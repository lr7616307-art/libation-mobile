<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Libation.Mobile.Android</RootNamespace>
    <ApplicationId>org.libationmobile.app</ApplicationId>
    <ApplicationTitle>Libation Mobile</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Libation.Mobile.UI\Libation.Mobile.UI.csproj" />
  </ItemGroup>
</Project>
